// Schema for the future booking/payment/admin backend.
// Not wired to a live database yet — no DATABASE_URL is required to build
// or run the marketing site. Provisioning target: Postgres (Neon/Supabase)
// via `vercel:vercel-storage` when the client is ready to go live.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum ServiceCategory {
  BRIDAL
  SOFT_GLAM
  FULL_GLAM
  EDITORIAL
  EDUCATION
}

enum AppointmentStatus {
  PENDING
  PAYMENT_PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW
}

enum PaymentStatus {
  UNPAID
  DEPOSIT_PENDING
  DEPOSIT_PAID
  PAID
  REFUNDED
}

model Customer {
  id           String        @id @default(cuid())
  firstName    String
  lastName     String
  email        String        @unique
  phone        String
  appointments Appointment[]
  createdAt    DateTime      @default(now())
}

model Service {
  id               String            @id @default(cuid())
  category         ServiceCategory
  name             String
  shortDescription String
  durationMinutes  Int
  priceFrom        Decimal           @db.Decimal(10, 2)
  currency         String            @default("EUR")
  depositRequired  Boolean           @default(true)
  depositAmount    Decimal?          @db.Decimal(10, 2)
  isActive         Boolean           @default(true)
  imageSrc         String
  appointments     Appointment[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Appointment {
  id            String            @id @default(cuid())
  service       Service           @relation(fields: [serviceId], references: [id])
  serviceId     String
  customer      Customer          @relation(fields: [customerId], references: [id])
  customerId    String
  startsAt      DateTime
  endsAt        DateTime
  status        AppointmentStatus @default(PENDING)
  paymentStatus PaymentStatus     @default(UNPAID)
  payments      Payment[]
  notes         String?
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  @@index([startsAt])
  @@index([status])
}

model Payment {
  id                String        @id @default(cuid())
  appointment       Appointment   @relation(fields: [appointmentId], references: [id])
  appointmentId     String
  provider          String
  providerReference String        @unique
  amount            Decimal       @db.Decimal(10, 2)
  currency          String        @default("EUR")
  status            PaymentStatus
  isDeposit         Boolean       @default(false)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt
}

/// Weekly recurring working hours, e.g. Tue 10:00-18:00.
model Availability {
  id        String   @id @default(cuid())
  weekday   Int // 0 = Sunday .. 6 = Saturday
  startTime String // "10:00"
  endTime   String // "18:00"
  isActive  Boolean  @default(true)
}

/// One-off closures: holidays, personal days, fully booked days.
model BlockedDate {
  id     String   @id @default(cuid())
  date   DateTime
  reason String?

  @@unique([date])
}

enum NotificationChannel {
  EMAIL
  SMS
}

enum NotificationType {
  BOOKING_CONFIRMATION
  BOOKING_REMINDER
  PAYMENT_RECEIPT
  CANCELLATION
}

model Notification {
  id            String              @id @default(cuid())
  appointmentId String
  channel       NotificationChannel
  type          NotificationType
  sentAt        DateTime?
  createdAt     DateTime            @default(now())
}
